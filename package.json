{
  "name": "rovik-ide",
  "private": true,
  "version": "0.1.68",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json --noEmit && node scripts/test.mjs",
    "test:eval": "node --test scripts/eval/lib.test.mjs scripts/eval/proc.test.mjs scripts/eval/caches.test.mjs",
    "test:scripts": "node --test scripts/release-notes.test.mjs scripts/updater-manifest.test.mjs"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "^3.13.49",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
