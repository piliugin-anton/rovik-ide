{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rovik IDE",
  "identifier": "rovik-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rovik IDE",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: chat-attachment: http://chat-attachment.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: chat-attachment: http://chat-attachment.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["bubblewrap"],
        "postInstallScript": "crates/rovik-core/linux/bwrap-apparmor.sh",
        "postRemoveScript": "crates/rovik-core/linux/bwrap-apparmor-remove.sh"
      },
      "rpm": {
        "depends": ["bubblewrap"],
        "postInstallScript": "crates/rovik-core/linux/bwrap-apparmor.sh",
        "postRemoveScript": "crates/rovik-core/linux/bwrap-apparmor-remove.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDOTQ2MzgwNDM2RjM3QTYKUldTbU4yOURnR09VZkdXKzgwUVduWXh0bWtYRXVRZFZWdXAweC9aT3RMTE1EcWs4ZUpKOG1rbTcK",
      "endpoints": [
        "https://github.com/piliugin-anton/rovik-ide/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
