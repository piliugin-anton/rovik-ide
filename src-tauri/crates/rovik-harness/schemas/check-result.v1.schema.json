{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "result_id",
    "operation_id",
    "check_id",
    "configuration_digest",
    "checker_digest",
    "evidence_key",
    "status",
    "exit_code",
    "executed_test_count",
    "passed_case_ids",
    "failed_case_ids",
    "skipped_case_ids",
    "evidence",
    "runner_receipt_id",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checker_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_digest",
        "contract_digest",
        "design_digest",
        "policy_digest",
        "oracle_digest",
        "plan_digest",
        "environment_digest"
      ],
      "properties": {
        "candidate_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "design_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "oracle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error",
        "timeout",
        "unsupported",
        "not_applicable"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "executed_test_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "failed_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "skipped_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "runner_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "message"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 0
    }
  }
}
