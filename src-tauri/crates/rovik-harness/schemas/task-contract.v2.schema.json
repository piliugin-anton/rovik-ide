{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContractV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "bounded_context",
    "profile_ids",
    "intent",
    "scope",
    "invariants",
    "acceptance_suite_ids",
    "constraints",
    "risk_tags",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "bounded_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_write",
        "protected"
      ],
      "properties": {
        "allow_write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "owner",
          "case_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "acceptance_suite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "blocking",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "numeric_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "wire_encoding",
        "overflow"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "wire_encoding": {
          "type": "string",
          "minLength": 1
        },
        "overflow": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
