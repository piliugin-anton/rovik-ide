1-1 variable_declaration M | local M = {}
2-2 variable_declaration helper | local helper = 1
3-3 function_declaration M.add | function M.add(a, b)
4-4 function_declaration M:method | function M:method() end
5-5 function_declaration private | local function private() end
6-6 assignment_statement M.handler | M.handler = function(x) return x end
7-7 function_declaration global_fn | function global_fn() end
