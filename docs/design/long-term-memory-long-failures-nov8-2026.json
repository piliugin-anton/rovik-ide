    "frozen_before_trials": true,
    "hypothesis": "A long failure can hide its final diagnostic even when the task itself is short. Embed only an explicitly separated final diagnostic paragraph that begins outside the declared input window, and append eligible matches into free slots after all existing views.",
    "policy": {
      "threshold": 0.3,
      "short_query_words": 2,
      "short_query_scale": 0.9166666666666666,
      "limit": 8,
      "budget": 1000
    },
    "guards": [
      "Preserve all previously delivered facts and ranks, negative IDs/order, visibility, scope, trust, tags and packet limit.",
      "Do not displace any existing result or change existing diagnostic cases.",
      "Test development before the exposed reserved split.",
      "Reuse existing model and indexes; no extra stored vectors."
    ],
    "limitation": "Synthetic correlated views, no blind or live-agent quality claim.",
    "amendment": {
      "before_second_trial": true,
      "reason": "Free-slot supplementation produced no development gain because all four misses had full pools.",
      "trial": "As a separate stress test, try the highest admitted final-paragraph semantic match in the final full-pool slot, preserving leading ranks; reject any negative-output change or previously supplied fact/rank loss. This relaxes the no-displacement design for this trial only, not the regression guards."
    },
    "retention_guard": "scripts/eval/memory-long-failure-retention-cases.json",
    "retention_note": "Registered before retention scoring; ten required facts cannot fit eight, so compare each supplied fact/rank.",
    "second_amendment": {
      "before_third_trial": true,
      "reason": "Unconditional replacement improved two development answers but worsened ten per-fact ranks in retention guards.",
      "trial": "Permit a tail match only for a task with no distinctive FTS terms, and only if the complete failure has no all/every/each/both/everything/entire/whole collection qualifier; keep top ranks and all earlier guards. Add generic-task collection retention guards before scoring."
    },
